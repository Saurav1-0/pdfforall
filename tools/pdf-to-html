<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PDF to HTML — PDFforAll</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../css/tool.css">
  <link rel="icon" href="../favicon.png" type="image/png">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <!-- Vercel Web Analytics -->
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<header>
  <div class="header-inner">
    <a href="../index.html" class="logo" style="text-decoration:none; display:flex; align-items:center; gap:0.5rem;">
      <img src="../logo.png" alt="PDFforAll Logo" width="32" height="32" style="display:block; object-fit:contain; border-radius:6px;">
      <span>PDF<span style="color:var(--primary);">for</span>All</span>
    </a>
    <div class="header-nav"><div style="display:flex;gap:0.5rem;align-items:center;"><a href="../support.html" class="btn-support" style="text-decoration:none;"><span>💖</span> Support</a><a href="../index.html" class="btn-back">← All Tools</a></div></div>
  </div>
</header>

<section class="tool-hero">
  <div class="tool-icon-large">🌐</div>
  <h1>PDF to HTML</h1>
  <p>Convert PDF text into a clean, downloadable HTML document, with OCR for scanned pages — directly in your browser.</p>
</section>

<div style="max-width:900px;margin:0 auto 1rem;padding:0 1rem;">
  <div role="note" style="background:rgba(255,180,80,0.08);border:1px solid rgba(255,180,80,0.28);border-radius:var(--radius);padding:1rem;font-size:0.85rem;line-height:1.6;color:var(--text);">
    <strong style="color:#ffb450;">⚠️ Conversion notice:</strong>
    If your PDF contains images, diagrams, charts, tables, or complex page layouts, the converted HTML may not look exactly like the original PDF. Images and visual formatting may not be preserved perfectly, and OCR text recognition can contain mistakes. Please review the converted HTML and make any necessary corrections.
  </div>
</div>

<div class="tool-workspace">
  <div class="drop-zone" id="dropZone">
    <input type="file" id="fileInput" accept=".pdf,application/pdf">
    <div class="drop-zone-icon">📄</div>
    <h3>Drop a PDF file here</h3>
    <p>or click to browse</p>
    <button class="btn-browse" type="button" onclick="document.getElementById('fileInput').click()">Browse File</button>
  </div>

  <!-- Separate picker: it remains available even while the drop zone is hidden. -->
  <input type="file" id="replacementInput" accept=".pdf,application/pdf" style="display:none;">

  <div id="controls" style="display:none;margin-top:1.5rem;">
    <div class="options-panel">
      <h3>Conversion Options</h3>
      <div class="option-row">
        <div><div class="option-label">Include Styling</div><div class="option-hint">Add basic CSS for readability</div></div>
        <input type="checkbox" id="includeCss" checked>
      </div>
      <div class="option-row">
        <div><div class="option-label">Page Separators</div><div class="option-hint">Keep each selected PDF page in its own section</div></div>
        <input type="checkbox" id="pageSep" checked>
      </div>
      <div class="option-row">
        <div><div class="option-label">OCR scanned pages</div><div class="option-hint">Recognize text from scanned/image-only pages (English). Runs locally in your browser.</div></div>
        <input type="checkbox" id="enableOcr" checked>
      </div>
      <div class="option-row">
        <div><div class="option-label">Pages</div></div>
        <select id="pageMode">
          <option value="all">All pages</option>
          <option value="range">Custom range</option>
        </select>
      </div>
      <div class="option-row" id="rangeRow" style="display:none;">
        <div><div class="option-label">Page Range</div><div class="option-hint">Example: 1-5, 8, 10-12</div></div>
        <input type="text" id="rangeInput" placeholder="e.g. 1-5, 8">
      </div>
      <div class="option-row">
        <div><div class="option-label">Selected file</div></div>
        <span id="fileInfo" style="font-size:.85rem;overflow-wrap:anywhere;"></span>
      </div>
    </div>
    <button class="btn-action" id="convertBtn" type="button">🌐 Convert to HTML</button>
    <button class="btn-browse" id="chooseAnotherBtn" type="button" style="margin-top:1rem;">Choose another PDF</button>
  </div>

  <div class="progress-wrap" id="progressWrap">
    <div class="progress-bar-bg"><div class="progress-bar-fill" id="progressFill"></div></div>
    <p class="progress-text" id="progressText">Processing…</p>
  </div>
  <div class="result-box" id="resultBox">
    <div class="result-success">
      <span class="result-success-icon">✅</span>
      <div class="result-success-text"><h4>HTML created!</h4><p id="resultInfo"></p></div>
    </div>
    <a class="btn-download" id="downloadBtn" href="#" download="document.html">⬇️ Download HTML</a>
  </div>
  <div class="error-box" id="errorBox"></div>
</div>

<footer class="tool-footer"><p>PDFforAll.in · <a href="../index.html">All Tools</a></p></footer>

<script>
(() => {
  'use strict';

  const PDFJS_CDN = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
  if (window.pdfjsLib) {
    pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_CDN + 'pdf.worker.min.js';
  }

  const $ = id => document.getElementById(id);

  let pdfFile = null;
  let pdfDoc = null;
  let activeUrl = null;
  let busy = false;
  let loadSequence = 0;

  const dropZone = $('dropZone');
  const fileInput = $('fileInput');
  const replacementInput = $('replacementInput');
  const controls = $('controls');
  const progressWrap = $('progressWrap');
  const progressFill = $('progressFill');
  const progressText = $('progressText');
  const resultBox = $('resultBox');
  const downloadBtn = $('downloadBtn');
  const errorBox = $('errorBox');
  const convertBtn = $('convertBtn');

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.add('visible');
  }

  function hideError() {
    errorBox.textContent = '';
    errorBox.classList.remove('visible');
  }

  function setProgress(percent, message) {
    progressWrap.classList.add('visible');
    progressFill.style.width = Math.max(0, Math.min(100, percent)) + '%';
    progressText.textContent = message;
  }

  function clearResult() {
    resultBox.classList.remove('visible');
    if (activeUrl) URL.revokeObjectURL(activeUrl);
    activeUrl = null;
    downloadBtn.removeAttribute('href');
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, character => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    })[character]);
  }

  function safeFilename(name) {
    return (name || 'document')
      .replace(/\.pdf$/i, '')
      .replace(/[\\/:*?"<>|]/g, '_')
      .trim() || 'document';
  }

  function parseRange(input, maxPages) {
    const selected = new Set();
    const parts = input.split(',').map(part => part.trim()).filter(Boolean);

    if (!parts.length) {
      throw new Error('Enter a page range, for example 1-5, 8, 10-12.');
    }

    for (const part of parts) {
      const match = part.match(/^(\d+)\s*(?:-\s*(\d+))?$/);
      if (!match) {
        throw new Error('Invalid page range. Use a format such as 1-5, 8, 10-12.');
      }

      const first = Number(match[1]);
      const last = match[2] ? Number(match[2]) : first;

      if (first < 1 || last < first || last > maxPages) {
        throw new Error(`Page range "${part}" is invalid. This PDF has ${maxPages} pages.`);
      }

      for (let page = first; page <= last; page++) selected.add(page);
    }

    return [...selected].sort((a, b) => a - b);
  }

  function textItemsToHtml(items) {
    const lines = [];

    for (const item of items) {
      if (!item.str || !item.str.trim()) continue;

      const transform = item.transform || [];
      const x = Number(transform[4]) || 0;
      const y = Number(transform[5]) || 0;
      const height = Math.abs(Number(transform[3]) || Number(item.height) || 10);

      let line = lines.find(candidate =>
        Math.abs(candidate.y - y) <= Math.max(2, height * 0.35)
      );

      if (!line) {
        line = { y, items: [] };
        lines.push(line);
      }

      line.items.push({
        x,
        text: item.str,
        width: Number(item.width) || 0
      });
    }

    lines.sort((a, b) => b.y - a.y);

    const paragraphs = lines.map(line => {
      line.items.sort((a, b) => a.x - b.x);
      let text = '';
      let previous = null;

      for (const item of line.items) {
        if (previous) {
          const gap = item.x - (previous.x + previous.width);
          text += gap > 8 ? '   ' : ' ';
        }
        text += item.text;
        previous = item;
      }

      return text.trim();
    }).filter(Boolean);

    return paragraphs.length
      ? paragraphs.map(line => `<p>${escapeHtml(line)}</p>`).join('\n')
      : '';
  }

  function makeOcrHtml(text) {
    const normalized = String(text || '').replace(/\r/g, '').trim();
    if (!normalized) {
      return '<p class="empty-page">OCR could not recognize readable text on this page.</p>';
    }

    return normalized
      .split(/\n\s*\n/)
      .map(paragraph => `<p>${escapeHtml(paragraph).replace(/\n/g, '<br>')}</p>`)
      .join('\n');
  }

  async function destroyCurrentPdf() {
    const oldDoc = pdfDoc;
    pdfDoc = null;
    if (oldDoc) {
      try {
        await oldDoc.destroy();
      } catch (error) {
        console.warn('PDFforAll: previous PDF cleanup warning', error);
      }
    }
  }

  async function loadFile(file) {
    if (!file || (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf')) {
      showError('Please select a PDF file.');
      return;
    }

    if (!file.size) {
      showError('The selected file is empty.');
      return;
    }

    if (!window.pdfjsLib) {
      showError('The PDF library could not load. Check your internet connection and refresh the page.');
      return;
    }

    const thisLoad = ++loadSequence;
    hideError();
    clearResult();
    progressWrap.classList.remove('visible');
    controls.style.display = 'none';
    dropZone.style.display = 'none';
    pdfFile = null;

    setProgress(8, 'Opening PDF…');

    try {
      await destroyCurrentPdf();
      const data = new Uint8Array(await file.arrayBuffer());

      if (thisLoad !== loadSequence) return;

      const loadingTask = pdfjsLib.getDocument({
        data,
        stopAtErrors: false,
        isEvalSupported: false,
        useSystemFonts: true
      });

      const openedDoc = await loadingTask.promise;

      if (thisLoad !== loadSequence) {
        try { await openedDoc.destroy(); } catch (_) {}
        return;
      }

      pdfDoc = openedDoc;
      pdfFile = file;
      $('fileInfo').textContent = `${file.name} · ${pdfDoc.numPages} page(s)`;
      controls.style.display = 'block';
      progressWrap.classList.remove('visible');
    } catch (error) {
      if (thisLoad !== loadSequence) return;
      progressWrap.classList.remove('visible');
      dropZone.style.display = 'block';
      controls.style.display = 'none';
      showError('Could not open this PDF: ' + (error.message || 'The file may be damaged or password-protected.'));
    }
  }

  function handleFileInput(input) {
    const file = input.files && input.files[0];
    // Clear immediately so selecting the same file again still triggers a change event.
    input.value = '';
    if (file) loadFile(file);
  }

  $('pageMode').addEventListener('change', () => {
    $('rangeRow').style.display = $('pageMode').value === 'range' ? 'flex' : 'none';
  });

  dropZone.addEventListener('dragover', event => {
    event.preventDefault();
    dropZone.classList.add('drag-over');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('drag-over');
  });

  dropZone.addEventListener('drop', event => {
    event.preventDefault();
    dropZone.classList.remove('drag-over');
    if (event.dataTransfer && event.dataTransfer.files[0]) {
      loadFile(event.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', () => handleFileInput(fileInput));
  replacementInput.addEventListener('change', () => handleFileInput(replacementInput));

  $('chooseAnotherBtn').addEventListener('click', () => {
    if (busy) return;
    // This input is outside the hidden drop zone; click occurs synchronously in the user gesture.
    replacementInput.click();
  });

  convertBtn.addEventListener('click', async () => {
    if (!pdfDoc || !pdfFile || busy) return;

    hideError();
    clearResult();

    const totalPages = pdfDoc.numPages;
    let selectedPages;

    try {
      selectedPages = $('pageMode').value === 'range'
        ? parseRange($('rangeInput').value, totalPages)
        : Array.from({ length: totalPages }, (_, index) => index + 1);
    } catch (error) {
      showError(error.message);
      return;
    }

    busy = true;
    convertBtn.disabled = true;
    convertBtn.textContent = 'Converting…';
    const sourceFile = pdfFile;
    const sourceDoc = pdfDoc;
    let ocrWorker = null;

    try {
      const includeSeparators = $('pageSep').checked;
      const includeCss = $('includeCss').checked;
      const enableOcr = $('enableOcr').checked;
      const title = safeFilename(sourceFile.name);
      const pageSections = [];
      let ocrPages = 0;
      let pagesWithoutText = 0;

      for (let index = 0; index < selectedPages.length; index++) {
        const pageNumber = selectedPages[index];
        setProgress(
          Math.round((index / selectedPages.length) * 88),
          `Extracting page ${pageNumber} of ${totalPages}…`
        );

        const page = await sourceDoc.getPage(pageNumber);
        const content = await page.getTextContent({ includeMarkedContent: false });
        const rawText = content.items
          .map(item => item.str || '')
          .join(' ')
          .replace(/\s+/g, ' ')
          .trim();

        let extracted = textItemsToHtml(content.items);

        // If a page has no text or only a tiny amount, treat it as likely scanned.
        const needsOcr = rawText.length < 20;

        if (needsOcr && enableOcr) {
          if (!window.Tesseract || typeof window.Tesseract.createWorker !== 'function') {
            throw new Error('OCR library did not load. Refresh the page or turn off "OCR scanned pages".');
          }

          if (!ocrWorker) {
            setProgress(4, 'Starting English OCR engine…');
            ocrWorker = await window.Tesseract.createWorker('eng', 1, {
              logger: event => {
                if (event.status) {
                  const pct = typeof event.progress === 'number'
                    ? ` ${Math.round(event.progress * 100)}%`
                    : '';
                  progressText.textContent = `OCR engine: ${event.status}${pct}`;
                }
              }
            });
          }

          setProgress(
            Math.round((index / selectedPages.length) * 88),
            `Rendering scanned page ${pageNumber} for OCR…`
          );

          const baseViewport = page.getViewport({ scale: 1 });
          const maxDimension = 2400;
          const scale = Math.min(1.7, maxDimension / Math.max(baseViewport.width, baseViewport.height));
          const viewport = page.getViewport({ scale: Math.max(0.5, scale) });
          const canvas = document.createElement('canvas');
          canvas.width = Math.ceil(viewport.width);
          canvas.height = Math.ceil(viewport.height);

          const context = canvas.getContext('2d', { alpha: false });
          if (!context) throw new Error('Your browser could not create an image canvas for OCR.');

          context.fillStyle = '#ffffff';
          context.fillRect(0, 0, canvas.width, canvas.height);

          await page.render({
            canvasContext: context,
            viewport,
            background: 'rgb(255,255,255)'
          }).promise;

          setProgress(
            Math.round((index / selectedPages.length) * 88),
            `Recognizing text on scanned page ${pageNumber}…`
          );

          const ocrResult = await ocrWorker.recognize(canvas);
          const recognizedText = ocrResult && ocrResult.data ? String(ocrResult.data.text || '').trim() : '';

          if (recognizedText) {
            extracted = makeOcrHtml(recognizedText);
            ocrPages++;
          } else if (!rawText) {
            pagesWithoutText++;
            extracted = '<p class="empty-page">OCR could not recognize readable text on this page.</p>';
          }

          canvas.width = 0;
          canvas.height = 0;
        } else if (needsOcr && !enableOcr && !rawText) {
          pagesWithoutText++;
          extracted = '<p class="empty-page">No selectable text was found. Enable "OCR scanned pages" to attempt text recognition on this page.</p>';
        }

        if (!extracted) {
          pagesWithoutText++;
          extracted = '<p class="empty-page">No readable text could be extracted from this page.</p>';
        }

        if (includeSeparators) {
          pageSections.push(`<section class="pdf-page" data-page="${pageNumber}">
  <h2>Page ${pageNumber}</h2>
  ${extracted}
</section>`);
        } else {
          pageSections.push(extracted);
        }

        page.cleanup();
      }

      const css = includeCss ? `
<style>
  * { box-sizing: border-box; }
  body { font-family: Georgia, "Times New Roman", serif; max-width: 900px; margin: 0 auto; padding: 2rem; background: #f7f7f7; color: #222; line-height: 1.65; }
  h1 { font-family: Arial, sans-serif; font-size: 1.8rem; margin: 0 0 2rem; overflow-wrap: anywhere; }
  .pdf-page { margin: 0 0 2rem; padding: 2rem; background: #fff; border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
  .pdf-page h2 { font: 600 .9rem Arial, sans-serif; color: #777; border-bottom: 1px solid #eee; padding-bottom: .6rem; margin: 0 0 1rem; }
  p { margin: .2rem 0 .55rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .empty-page { color: #777; font-style: italic; }
  @media (max-width: 600px) { body { padding: 1rem; } .pdf-page { padding: 1rem; } }
  @media print { body { max-width: none; background: #fff; padding: 0; } .pdf-page { box-shadow: none; break-after: page; } }
</style>` : '';

      const standaloneHtml = `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>${escapeHtml(title)}</title>
${css}
</head>
<body>
<h1>${escapeHtml(title)}</h1>
${pageSections.join('\n')}
</body>
</html>`;

      setProgress(96, 'Preparing downloadable HTML…');
      const blob = new Blob([standaloneHtml], { type: 'text/html;charset=utf-8' });

      if (activeUrl) URL.revokeObjectURL(activeUrl);
      activeUrl = URL.createObjectURL(blob);
      downloadBtn.href = activeUrl;
      downloadBtn.download = title + '.html';

      let summary = `${selectedPages.length} page(s) converted.`;
      if (ocrPages) summary += ` OCR was applied to ${ocrPages} page(s).`;
      if (pagesWithoutText) summary += ` ${pagesWithoutText} page(s) had no readable text.`;
      summary += ` Output: ${(blob.size / 1024).toFixed(1)} KB.`;
      $('resultInfo').textContent = summary;

      setProgress(100, 'Conversion complete!');
      setTimeout(() => {
        progressWrap.classList.remove('visible');
        resultBox.classList.add('visible');
      }, 350);
    } catch (error) {
      showError('Conversion failed: ' + (error.message || String(error)));
      progressWrap.classList.remove('visible');
    } finally {
      if (ocrWorker) {
        try { await ocrWorker.terminate(); } catch (error) {
          console.warn('PDFforAll: OCR worker cleanup warning', error);
        }
      }
      busy = false;
      convertBtn.disabled = false;
      convertBtn.textContent = '🌐 Convert to HTML';
    }
  });

  window.addEventListener('beforeunload', () => {
    if (activeUrl) URL.revokeObjectURL(activeUrl);
  });
})();
</script>
</body>
</html>
